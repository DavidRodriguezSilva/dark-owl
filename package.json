{
  "name": "dark-owl",
  "productName": "Dark Owl",
  "version": "0.1.0",
  "private": true,
  "description": "Grabadora minimalista de voz a texto, 100% offline, sobre whisper.cpp. Grabar, pausar, detener, transcribir, limpiar, reprocesar.",
  "main": "src/main/main.js",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "start": "electron .",
    "setup": "node scripts/setup-whisper.js",
    "setup:cuda": "node scripts/setup-whisper.js --cuda",
    "prueba:ajustes": "node scripts/prueba-ajustes.js",
    "prueba:archivo": "node scripts/prueba-archivo.js",
    "prueba:microfono": "node scripts/prueba-microfono.js",
    "prueba:texto": "node scripts/prueba-texto.js",
    "icono": "electron scripts/icono.js",
    "iconos": "node scripts/iconos.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "smoke": "electron scripts/smoke.js",
    "smoke:motor": "electron scripts/smoke-motor.js",
    "smoke:ajustes": "electron scripts/smoke-ajustes.js",
    "smoke:archivo": "electron scripts/smoke-archivo.js"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "forest.dark.owl",
    "productName": "Dark Owl",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "bin/whisper-server*",
          "bin/whisper-cli*",
          "bin/*.dll",
          "lib/**",
          "models/*.bin"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "perMachine": false
    }
  }
}
